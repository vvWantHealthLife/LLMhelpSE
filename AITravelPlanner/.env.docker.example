# Registry & tag for docker-compose (frontend + backend)
REGISTRY=registry.cn-hangzhou.aliyuncs.com
NAMESPACE=your_namespace
TAG=latest

# Backend service environment variables
PORT=3000
NODE_ENV=production

# Third-party keys (replace with your own before running)
AMAP_KEY=your_amap_web_key

# Aliyun Bailian (DashScope) / OpenAI keys
DASHSCOPE_API_KEY=your_dashscope_key
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# iFLYTEK Spark keys (if used)
IFLYTEK_APPID=your_appid
IFLYTEK_API_KEY=your_api_key
IFLYTEK_API_SECRET=your_api_secret
IFLYTEK_API_HOST=https://spark-api.xf-yun.com
IFLYTEK_API_VERSION=v3.5

# Optional: other configs used by backend
JWT_SECRET=please_change_me
MONGODB_URI=mongodb://user:pass@host:27017/ai_travel_planner
REDIS_URL=redis://host:6379

# Note: Do not commit real secrets publicly.
# Use GitHub Secrets in CI and pass at runtime locally.