# Registry & tag for docker-compose (frontend + backend)
REGISTRY=registry.cn-hangzhou.aliyuncs.com
NAMESPACE=your_namespace
TAG=latest

# Backend service environment variables
PORT=3000
NODE_ENV=production

# Backend environment variables for Compose (used by back/service)
MAX_BODY_SIZE=15mb
DB_CONNECTION_STRING=mongodb://localhost:27017/ai_travel_planner
JWT_SECRET=please_change_me
LLM_API_KEY=your_openai_key
OPENAI_MODEL=gpt-3.5-turbo
BAILIAN_API_KEY=your_dashscope_key
BAILIAN_MODEL=qwen-turbo
MAP_API_KEY=your_amap_rest_key
SPEECH_API_KEY=your_xfyun_api_key
SPEECH_API_APPID=your_xfyun_appid
SPEECH_API_SECRET=your_xfyun_secret

# Frontend GAODE JS API (if you use front/src/amapConfig.js)
AMAP_KEY=your_amap_web_key

# Note: Do not commit real secrets publicly.
# Use GitHub Secrets in CI and pass at runtime locally.